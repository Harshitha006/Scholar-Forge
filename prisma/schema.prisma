generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String                @id // Clerk user ID
  projects       Project[]             @relation("owner")
  collaborations ProjectCollaborator[]
  createdAt      DateTime              @default(now())
}

model Project {
  id               String                @id @default(cuid())
  title            String
  paperType        String // survey | empirical | theoretical
  venue            String // IEEE | ACM | generic
  domain           String
  researchQuestion String?
  keywords         String[]
  outline          Json?
  ownerId          String
  owner            User                  @relation("owner", fields: [ownerId], references: [id])
  collaborators    ProjectCollaborator[]
  sections         Section[]
  pinnedPapers     PinnedPaper[]
  citations        Citation[]
  artifacts        Artifact[]
  taskRuns         TaskRun[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model ProjectCollaborator {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String // intro | lit_review | methods | results | discussion | conclusion | custom
  title     String
  order     Int
  plainText String   @default("")
  latexText String   @default("")
  status    String   @default("draft") // draft | ai_generated | human_reviewed | ready
  updatedAt DateTime @updatedAt
}

model PinnedPaper {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  paperId   String // reference to vector DB / local metadata
  title     String
  authors   String[]
  year      Int?
  abstract  String?
  filePath  String?
  citKey    String // BibTeX key
  createdAt DateTime @default(now())
}

model Citation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  key       String // BibTeX key
  bibtex    String
  title     String
  authors   String[]
  year      Int?
  used      Boolean  @default(false)
}

model Artifact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String // tex | pdf | bib | markdown
  blobUrl   String
  createdAt DateTime @default(now())
}

model TaskRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String // topic_refinement | section_draft | compile | etc.
  status    String   @default("pending") // pending | running | done | failed
  logs      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
